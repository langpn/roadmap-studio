{
  "name": "roadmap-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:private": "APP_MODE=private BETTER_AUTH_URL=http://127.0.0.1:3001 next dev --webpack --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/bootstrap.ts",
    "catalog:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-catalog.ts",
    "local:db": "node --env-file-if-exists=.env.local --import tsx scripts/local-db.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "hls.js": "1.7.4",
    "lucide-react": "1.70.0",
    "media-chrome": "4.19.4",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "postgres": "3.4.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
