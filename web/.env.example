# Cục bộ: để trống DATABASE_URL để dùng PostgreSQL nhúng trong .data/.
# Để trống nếu dùng cơ sở dữ liệu nhúng trên máy này.
DATABASE_URL=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Khi để trống, ứng dụng tự tạo khóa cục bộ trong .data/.
BETTER_AUTH_SECRET=
# Chỉ bật dữ liệu giả lập trong môi trường trình diễn riêng.
APP_MODE=private
# Tùy chọn khi bổ sung khóa: đường dẫn manifest JSON và thư mục gốc của các tệp nguồn.
CATALOG_MANIFEST=
CATALOG_SOURCE_ROOT=
# SMTP là tùy chọn; chỉ điền trong .env.local khi muốn gửi thư thật.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
