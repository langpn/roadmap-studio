# Chỉ đưa mã ứng dụng và cấu hình cần thiết vào Git.
# Tài liệu nghiên cứu, danh mục khóa học và dữ liệu cá nhân vẫn nằm trên máy.
/*
!/.gitignore
!/README.md
!/web/

/web/*
!/web/.gitignore
!/web/.env.example
!/web/AGENTS.md
!/web/README.md
!/web/catalog-manifest.example.json
!/web/eslint.config.mjs
!/web/next.config.ts
!/web/package.json
!/web/playwright.config.ts
!/web/pnpm-lock.yaml
!/web/pnpm-workspace.yaml
!/web/tsconfig.json
!/web/vitest.config.ts
!/web/docs/
/web/docs/*
!/web/docs/huong-dan-dang-nhap.md
!/web/docs/thu-dien-tu.md
!/web/docs/van-hanh-local.md
!/web/public/
/web/public/*
!/web/public/demo/
/web/public/demo/*
!/web/scripts/
!/web/src/
!/web/tests/

# Bảo vệ dữ liệu cục bộ ngay cả khi chúng xuất hiện trong thư mục mã nguồn.
**/.env
**/.env.*
!**/.env.example
**/.data/
**/node_modules/
**/.next*/
**/.vitest/
**/coverage/
**/test-results/
**/playwright-report/
*.tsbuildinfo
*.sqlite
*.sqlite3
*.db
*.dump
*.pem
*.key
*.mp4
*.mov
*.mkv
*.webm
*.m3u8
*.mpegts
.DS_Store
# Video tổng hợp chỉ dùng để kiểm thử và minh họa trình phát.
!/web/public/demo/player-sample.mp4
